# Secrets des Edge Functions — se règlent côté Supabase, jamais dans le dépôt :
#   npx supabase secrets set NOM=valeur   (ou Dashboard → Edge Functions → Secrets)
# En local (`supabase functions serve`), copier ce fichier en `.env` à côté.
#
# Vérifié par src/lib/config-exemple.test.ts : toute variable lue par
# `Deno.env.get('…')` doit figurer ici, et inversement.

# ── Fournies automatiquement par la plateforme Supabase (ne pas les poser) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Synchro Dmbook (ADR 0016) ───────────────────────────────────────────────
# Niveau d'écriture vers Dmbook : aucune | test | toutes. Absent ou inconnu =
# « aucune » (lecture seule). L'ouvrir est une décision du PO.
DMBOOK_ECRITURE=aucune
# « oui » autorise un passage réel déclenché à la main ; tout autre valeur =
# simulation. Posé seulement après accord du PO.
DMBOOK_SYNC_REEL=
